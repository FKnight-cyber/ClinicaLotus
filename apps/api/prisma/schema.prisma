generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum PasswordChangeRequestStatus {
  PENDING
  APPROVED
  CANCELED
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum ClinicStatus {
  ACTIVE
  INACTIVE
}

enum UserClinicStatus {
  ACTIVE
  INACTIVE
}

enum PatientClinicStatus {
  ACTIVE
  INACTIVE
}

enum AnamnesisStatus {
  DRAFT
  FINALIZED
  CANCELED
}

enum MedicalEvolutionStatus {
  DRAFT
  FINALIZED
  CANCELED
}

enum QuestionType {
  TEXT
  TEXTAREA
  DATE
  TIME
  NUMBER
  YES_NO
  YES_NO_DETAILS
  SINGLE_CHOICE
  MULTI_CHOICE
  TABLE
}

enum TableRowSource {
  TEMPLATE
  CUSTOM
}

enum UserType {
  MANAGER
  PATIENT
  NURSE
  DOCTOR
}

model User {
  id                 String            @id @default(uuid())
  login              String            @unique
  name               String            @unique
  email              String?           @unique
  userType           UserType          @default(MANAGER)
  professionalArea   String?
  professionalCouncil String?
  professionalRegistration String?
  professionalCouncilState String?
  professionalSpecialty String?
  passwordHash       String
  status             UserStatus        @default(ACTIVE)
  mustChangePassword Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  groups             UserAccessGroup[]
  createdAnamneses   AnamnesisRecord[] @relation("AnamnesisCreatedBy")
  updatedAnamneses   AnamnesisRecord[] @relation("AnamnesisUpdatedBy")
  medicalRecordEntries MedicalRecordEntry[]
  createdMedicalEvolutions MedicalEvolution[] @relation("MedicalEvolutionCreatedBy")
  updatedMedicalEvolutions MedicalEvolution[] @relation("MedicalEvolutionUpdatedBy")
  finalizedMedicalEvolutions MedicalEvolution[] @relation("MedicalEvolutionFinalizedBy")
  canceledMedicalEvolutions MedicalEvolution[] @relation("MedicalEvolutionCanceledBy")
  emittedDocuments   ClinicalDocument[]
  auditLogs          AuditLog[]
  passwordChangeRequests PasswordChangeRequest[] @relation("PasswordChangeRequestedBy")
  reviewedPasswordChangeRequests PasswordChangeRequest[] @relation("PasswordChangeReviewedBy")
  clinics            UserClinic[]
}

model Clinic {
  id        String       @id @default(uuid())
  name      String
  code      String?      @unique
  document  String?
  status    ClinicStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users     UserClinic[]
  patients  Patient[]
  patientLinks PatientClinic[]
  accessGroups AccessGroupClinic[]
  anamnesisRecords AnamnesisRecord[]
  medicalRecordEntries MedicalRecordEntry[]
  medicalEvolutions MedicalEvolution[]
  clinicalDocuments ClinicalDocument[]
  auditLogs AuditLog[]

  @@index([status, name])
}

model UserClinic {
  userId     String
  clinicId   String
  status     UserClinicStatus @default(ACTIVE)
  isDefault  Boolean          @default(false)
  assignedAt DateTime         @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic     Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([userId, clinicId])
  @@index([clinicId, status])
}

model PasswordChangeRequest {
  id                    String                      @id @default(uuid())
  userId                String
  requestedPasswordHash String?
  status                PasswordChangeRequestStatus @default(PENDING)
  requestedAt           DateTime                    @default(now())
  reviewedAt            DateTime?
  reviewedById          String?
  updatedAt             DateTime                    @updatedAt
  user                  User                        @relation("PasswordChangeRequestedBy", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy            User?                       @relation("PasswordChangeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([userId, status])
}

model AccessGroup {
  id          String                  @id @default(uuid())
  name        String                  @unique
  description String?
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  users       UserAccessGroup[]
  permissions AccessGroupPermission[]
  clinics     AccessGroupClinic[]
}

model AccessGroupClinic {
  accessGroupId String
  clinicId      String
  assignedAt    DateTime    @default(now())
  accessGroup   AccessGroup @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)
  clinic        Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([accessGroupId, clinicId])
  @@index([clinicId])
}

model Permission {
  id          String                  @id @default(uuid())
  key         String                  @unique
  module      String
  action      String
  description String?
  active      Boolean                 @default(true)
  groups      AccessGroupPermission[]
}

model UserAccessGroup {
  userId        String
  accessGroupId String
  assignedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessGroup   AccessGroup @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)

  @@id([userId, accessGroupId])
}

model AccessGroupPermission {
  accessGroupId String
  permissionId  String
  assignedAt    DateTime    @default(now())
  accessGroup   AccessGroup @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)
  permission    Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([accessGroupId, permissionId])
}

model Patient {
  id              String            @id @default(uuid())
  name            String
  status          PatientStatus     @default(ACTIVE)
  clinicId        String
  birthDate       DateTime?
  document        String?
  cpf             String?
  rg              String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  clinic          Clinic            @relation(fields: [clinicId], references: [id])
  clinics         PatientClinic[]
  anamnesisRecord AnamnesisRecord[]
  medicalRecordEntries MedicalRecordEntry[]
  medicalEvolutions MedicalEvolution[]
  clinicalDocuments ClinicalDocument[]

  @@index([clinicId, status])
}

model PatientClinic {
  patientId   String
  clinicId    String
  status      PatientClinicStatus @default(ACTIVE)
  firstSeenAt DateTime            @default(now())
  lastSeenAt  DateTime?

  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic      Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@id([patientId, clinicId])
  @@index([clinicId, status])
}

model AnamnesisTemplate {
  id          String             @id @default(uuid())
  key         String             @unique
  title       String
  shortTitle  String?
  source      String?
  description String?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  sections    AnamnesisSection[]
}

model AnamnesisSection {
  id         String              @id @default(uuid())
  templateId String
  key        String
  title      String
  description String?
  sortOrder  Int                 @default(0)
  active     Boolean             @default(true)
  template   AnamnesisTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions  AnamnesisQuestion[]

  @@unique([templateId, key])
}

model AnamnesisQuestion {
  id        String                    @id @default(uuid())
  sectionId String
  key       String
  label     String
  type      QuestionType
  placeholder String?
  helper    String?
  tableColumnsJson String?
  required  Boolean                   @default(false)
  sortOrder Int                       @default(0)
  active    Boolean                   @default(true)
  section   AnamnesisSection          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options   AnamnesisQuestionOption[]
  answers   AnamnesisAnswer[]
  rows      AnamnesisTableRow[]
  templateRows AnamnesisQuestionTableRow[]

  @@unique([sectionId, key])
}

model AnamnesisQuestionOption {
  id         String            @id @default(uuid())
  questionId String
  label      String
  sortOrder  Int               @default(0)
  active     Boolean           @default(true)
  question   AnamnesisQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AnamnesisQuestionTableRow {
  id         String            @id @default(uuid())
  questionId String
  label      String
  sortOrder  Int               @default(0)
  active     Boolean           @default(true)
  question   AnamnesisQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AnamnesisRecord {
  id          String             @id @default(uuid())
  code        String             @unique
  status      AnamnesisStatus    @default(DRAFT)
  patientName String
  patientId   String?
  clinicId    String
  customFieldsJson String?
  customAnswersJson String?
  templateConfigJson String?
  templateStatusesJson String?
  createdById String?
  updatedById String?
  finalizedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  patient     Patient?           @relation(fields: [patientId], references: [id])
  clinic      Clinic             @relation(fields: [clinicId], references: [id])
  createdBy   User?              @relation("AnamnesisCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?              @relation("AnamnesisUpdatedBy", fields: [updatedById], references: [id])
  answers     AnamnesisAnswer[]
  tableRows   AnamnesisTableRow[]
  medicalRecordEntries MedicalRecordEntry[]
  clinicalDocuments ClinicalDocument[]

  @@index([clinicId, createdAt])
}

model MedicalRecordEntry {
  id                String           @id @default(uuid())
  patientId         String
  clinicId          String
  anamnesisRecordId String?
  medicalEvolutionId String?
  type              String
  title             String
  summary           String?
  createdById       String?
  createdAt         DateTime         @default(now())
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic            Clinic           @relation(fields: [clinicId], references: [id])
  anamnesisRecord   AnamnesisRecord? @relation(fields: [anamnesisRecordId], references: [id], onDelete: SetNull)
  medicalEvolution  MedicalEvolution? @relation(fields: [medicalEvolutionId], references: [id], onDelete: SetNull)
  createdBy         User?            @relation(fields: [createdById], references: [id])

  @@index([clinicId, createdAt])
}

model MedicalEvolution {
  id                   String                 @id @default(uuid())
  patientId            String
  clinicId             String
  status               MedicalEvolutionStatus @default(DRAFT)
  evolutionDate        DateTime               @default(now())
  text                 String
  professionalArea     String?
  professionalName     String?
  finalizedProfessionalName String?
  finalizedProfessionalCouncil String?
  finalizedProfessionalRegistration String?
  finalizedProfessionalCouncilState String?
  finalizedProfessionalSpecialty String?
  createdById          String?
  updatedById          String?
  finalizedById        String?
  canceledById         String?
  finalizedAt          DateTime?
  canceledAt           DateTime?
  cancelReason         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  patient              Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic               Clinic                 @relation(fields: [clinicId], references: [id])
  createdBy            User?                  @relation("MedicalEvolutionCreatedBy", fields: [createdById], references: [id])
  updatedBy            User?                  @relation("MedicalEvolutionUpdatedBy", fields: [updatedById], references: [id])
  finalizedBy          User?                  @relation("MedicalEvolutionFinalizedBy", fields: [finalizedById], references: [id])
  canceledBy           User?                  @relation("MedicalEvolutionCanceledBy", fields: [canceledById], references: [id])
  medicalRecordEntries MedicalRecordEntry[]
  clinicalDocuments    ClinicalDocument[]

  @@index([patientId, evolutionDate])
  @@index([clinicId, evolutionDate])
  @@index([status])
}

model ClinicalDocument {
  id                String           @id @default(uuid())
  code              String           @unique
  type              String
  fileName          String
  contentHash       String
  metadataJson      String?
  patientId         String?
  clinicId          String
  anamnesisRecordId String?
  medicalEvolutionId String?
  emittedById       String?
  emittedAt         DateTime         @default(now())
  patient           Patient?         @relation(fields: [patientId], references: [id], onDelete: SetNull)
  clinic            Clinic           @relation(fields: [clinicId], references: [id])
  anamnesisRecord   AnamnesisRecord? @relation(fields: [anamnesisRecordId], references: [id], onDelete: Cascade)
  medicalEvolution  MedicalEvolution? @relation(fields: [medicalEvolutionId], references: [id], onDelete: Cascade)
  emittedBy         User?            @relation(fields: [emittedById], references: [id])

  @@index([clinicId, emittedAt])
}

model AnamnesisAnswer {
  id         String             @id @default(uuid())
  recordId   String
  questionId String
  valueText  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  record     AnamnesisRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  question   AnamnesisQuestion  @relation(fields: [questionId], references: [id])

  @@unique([recordId, questionId])
}

model AnamnesisTableRow {
  id         String               @id @default(uuid())
  recordId   String
  questionId String
  label      String
  source     TableRowSource       @default(TEMPLATE)
  sortOrder  Int                  @default(0)
  active     Boolean              @default(true)
  record     AnamnesisRecord      @relation(fields: [recordId], references: [id], onDelete: Cascade)
  question   AnamnesisQuestion    @relation(fields: [questionId], references: [id])
  cells      AnamnesisTableCell[]
}

model AnamnesisTableCell {
  id        String            @id @default(uuid())
  rowId     String
  columnKey String
  valueText String?
  row       AnamnesisTableRow @relation(fields: [rowId], references: [id], onDelete: Cascade)

  @@unique([rowId, columnKey])
}

model AuditLog {
  id         String   @id @default(uuid())
  entity     String
  entityId   String?
  action     String
  beforeData String?
  afterData  String?
  reason     String?
  userId     String?
  clinicId   String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  clinic     Clinic?  @relation(fields: [clinicId], references: [id])

  @@index([entity, createdAt])
  @@index([clinicId, createdAt])
  @@index([userId])
}